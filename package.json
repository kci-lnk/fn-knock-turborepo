{
  "name": "fn-knock-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "a11y:audit": "node ./scripts/a11y-runtime-audit.mjs",
    "security:audit": "node ./scripts/security-audit.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "fn-knock:assemble-runtime": "bash ./scripts/assemble-runtime.sh",
    "fn-knock:prepare-artifacts": "bash ./scripts/fn-knock-prepare-artifacts.sh",
    "fn-knock:linux:prepare": "bash ./scripts/fn-knock-prepare-artifacts.sh linux",
    "fn-knock:linux:build": "bash ./scripts/fn-knock-prepare-artifacts.sh linux",
    "fn-knock:synology:build": "bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:synology:build:all": "bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:synology:build:x86_64": "bash ./apps/fn-knock-synology/scripts/build-package.sh x86_64",
    "fn-knock:synology:build:armv8": "bash ./apps/fn-knock-synology/scripts/build-package.sh armv8",
    "fn-knock:synology:build:armv7": "bash ./apps/fn-knock-synology/scripts/build-package.sh armv7",
    "fn-knock:synology:build:prepared": "FN_KNOCK_SYNOLOGY_SKIP_ARTIFACT_PREPARE=1 bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:spk:build": "bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:spk:build:all": "bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:spk:build:x86_64": "bash ./apps/fn-knock-synology/scripts/build-package.sh x86_64",
    "fn-knock:spk:build:armv8": "bash ./apps/fn-knock-synology/scripts/build-package.sh armv8",
    "fn-knock:spk:build:armv7": "bash ./apps/fn-knock-synology/scripts/build-package.sh armv7",
    "fn-knock:spk:build:prepared": "FN_KNOCK_SYNOLOGY_SKIP_ARTIFACT_PREPARE=1 bash ./apps/fn-knock-synology/scripts/build-all-packages.sh",
    "fn-knock:build-package": "./apps/fn-knock/scripts/build-package.sh",
    "fn-knock:fpk:copy-back": "./apps/fn-knock/scripts/build-package.sh copy-fpk",
    "fn-knock:fpk:remote": "bash ./scripts/fn-knock-deploy.sh pack-remote",
    "fn-knock:lite:build-package": "./apps/fn-knock-lite/scripts/build-package.sh",
    "fn-knock:lite:fpk:copy-back": "./apps/fn-knock-lite/scripts/build-package.sh copy-fpk",
    "fn-knock:lite:fpk:remote": "bash ./scripts/fn-knock-lite-deploy.sh pack-remote",
    "fn-knock:lite:fpk:install:remote": "bash ./scripts/fn-knock-lite-deploy.sh install-remote",
    "fn-knock:lite:fpk:verify:remote": "bash ./scripts/fn-knock-lite-deploy.sh verify-remote",
    "fn-knock:lite:fpk:deploy": "bash ./scripts/fn-knock-lite-deploy.sh deploy",
    "fn-knock:lite:test": "bash ./scripts/tests/test-fpk-lite.sh",
    "fn-knock:install:remote": "bash ./scripts/fn-knock-deploy.sh install-remote",
    "fn-knock:verify:remote": "bash ./scripts/fn-knock-deploy.sh verify-remote",
    "fn-knock:deploy": "bash ./scripts/fn-knock-deploy.sh deploy",
    "fn-knock:deploy-all": "bash ./scripts/fn-knock-deploy-all.sh",
    "release": "node ./scripts/fn-knock-release.mjs",
    "fn-knock:release:preflight": "bash ./scripts/release-preflight.sh",
    "fn-knock:release:test": "bash ./scripts/verify-go-control-api-contract.sh && bash ./scripts/tests/test-runtime-health-platform-contract.sh && bash ./scripts/tests/test-release-preflight.sh && bash ./scripts/tests/test-release-cli.sh && bash ./scripts/tests/test-release-build-helpers.sh && bash ./scripts/tests/test-openwrt-tar-compat.sh && bash ./scripts/tests/test-openwrt-runtime-contract.sh && bash ./scripts/tests/test-synology-package-validation.sh && bash ./scripts/tests/test-windows-smoke-exit-status.sh && bash ./scripts/tests/test-workflow-action-pins.sh && bash ./scripts/tests/test-cos-release-workflow.sh && bash ./scripts/tests/test-fpk-staging.sh && bash ./scripts/tests/test-release-finalize.sh && node --test ./scripts/tests/fn-knock-cos-publish.test.mjs && bash ./scripts/tests/test-update-cdn-cache.sh",
    "fn-knock:release:fpk": "bash ./scripts/fn-knock-package-fpk.sh",
    "fn-knock:release:assemble": "bash ./scripts/fn-knock-assemble-release.sh",
    "fn-knock:grpc:sync-go": "bash ./scripts/sync-go-grpc-contract.sh",
    "fn-knock:grpc:check-go": "bash ./scripts/verify-go-control-api-contract.sh",
    "fn-knock:deploy-fast": "FN_KNOCK_FPK_ARCHES=amd64 FN_KNOCK_RUST_PARALLEL_RELEASE=1 FN_KNOCK_FORCE_ARTIFACT_REBUILD=1 FN_KNOCK_FORCE_FRONTEND_REBUILD=1 FN_KNOCK_GO_REAUTH_PROXY_FORCE_BUILD=1 bash ./scripts/fn-knock-deploy.sh deploy",
    "fn-knock:openwrt:build": "bash ./scripts/build-openwrt-ipk.sh",
    "fn-knock:openwrt:build-ipk": "FN_KNOCK_OPENWRT_FORMATS=ipk bash ./scripts/build-openwrt-ipk.sh",
    "fn-knock:openwrt:test": "bash ./scripts/tests/test-openwrt-runtime-contract.sh && bash ./scripts/tests/test-openwrt-tar-compat.sh",
    "fn-knock:windows:prepare": "pwsh -NoProfile -File ./scripts/fn-knock-windows.ps1 -Mode Prepare",
    "fn-knock:windows:test": "pwsh -NoProfile -File ./scripts/fn-knock-windows.ps1 -Mode Test",
    "fn-knock:windows:build": "pwsh -NoProfile -File ./scripts/fn-knock-windows.ps1 -Mode Build -BundleInstaller",
    "fn-knock:docker:build": "bash ./scripts/fn-knock-docker.sh build-local",
    "fn-knock:docker:up": "bash ./scripts/fn-knock-docker.sh up-local",
    "fn-knock:docker:down": "bash ./scripts/fn-knock-docker.sh down-local",
    "fn-knock:docker:logs": "bash ./scripts/fn-knock-docker.sh logs-local",
    "fn-knock:docker:reset-panel-password": "bash ./scripts/fn-knock-docker.sh reset-panel-password-local",
    "fn-knock:docker:local-deploy-fast": "bash ./scripts/fn-knock-docker.sh local-deploy-fast",
    "fn-knock:docker:local-deploy": "bash ./scripts/fn-knock-docker.sh local-deploy",
    "fn-knock:docker:hub-publish": "bash ./scripts/fn-knock-docker.sh publish-hub",
    "fn-knock:docker:remote-ps": "bash ./scripts/fn-knock-docker.sh remote-ps",
    "fn-knock:docker:remote-logs": "bash ./scripts/fn-knock-docker.sh remote-logs",
    "fn-knock:docker:remote-reset-panel-password": "bash ./scripts/fn-knock-docker.sh reset-panel-password-remote",
    "i18n:check": "tsx ./packages/i18n/scripts/check.mjs",
    "i18n:export-server": "tsx ./packages/i18n/scripts/export-server.mjs",
    "i18n:scan": "node ./packages/i18n/scripts/scan.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "tencentcloud-sdk-nodejs-cdn": "4.1.250",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/server-admin-rs",
    "apps/server-admin-view",
    "apps/server-auth-view",
    "apps/fn-knock-desktop",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.4",
    "immutable": "5.1.9",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
