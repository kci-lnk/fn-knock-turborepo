#!/bin/sh

PACKAGE_NAME="${SYNOPKG_PKGNAME:-fn-knock-synology}"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PACKAGE_NAME}/target}"
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${PACKAGE_NAME}/var}"
PKGTMP="${SYNOPKG_PKGTMP:-/var/packages/${PACKAGE_NAME}/tmp}"
PKGHOME="${SYNOPKG_PKGHOME:-/var/packages/${PACKAGE_NAME}/home}"
PID_FILE="${PKGVAR}/fn-knock.pid"
LOG_FILE="${PKGVAR}/fn-knock.log"
ENTRYPOINT="${PKGDEST}/bin/fn-knock-entrypoint"
BACKEND_PORT="${BACKEND_PORT:-7998}"

pid_is_running() {
    [ -r "${PID_FILE}" ] || return 1
    PID="$(cat "${PID_FILE}" 2>/dev/null)"
    case "${PID}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "${PID}" 2>/dev/null || return 1
    [ -r "/proc/${PID}/cmdline" ] || return 0
    tr '\000' ' ' < "/proc/${PID}/cmdline" | grep -q 'fn-knock-entrypoint'
}

write_runtime_ports() {
    umask 022
    {
        printf 'ADMIN_TARGET_HOST=127.0.0.1\n'
        printf 'ADMIN_TARGET_PORT=%s\n' "${BACKEND_PORT}"
        printf 'BACKEND_PORT=%s\n' "${BACKEND_PORT}"
        printf 'AUTH_PORT=%s\n' "${AUTH_PORT:-7997}"
        printf 'GO_BACKEND_PORT=%s\n' "${GO_BACKEND_PORT:-7996}"
        printf 'GO_REPROXY_PORT=%s\n' "${GO_REPROXY_PORT:-7999}"
    } > "${PKGVAR}/runtime-ports.env"
    chmod 644 "${PKGVAR}/runtime-ports.env"
}

start_service() {
    if pid_is_running; then
        return 0
    fi
    rm -f "${PID_FILE}"
    mkdir -p "${PKGVAR}" "${PKGTMP}" "${PKGHOME}"
    write_runtime_ports
    umask 077
    PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/syno/bin" \
    HOME="${PKGHOME}" \
    TMPDIR="${PKGTMP}" \
    FN_KNOCK_APP_HOME="${PKGDEST}" \
    FN_KNOCK_DATA_DIR="${PKGVAR}" \
    FN_KNOCK_GATEWAY_CONFIG_DIR="${PKGVAR}/gateway" \
    BACKEND_PORT="${BACKEND_PORT}" \
    AUTH_PORT="${AUTH_PORT:-7997}" \
    GO_BACKEND_PORT="${GO_BACKEND_PORT:-7996}" \
    GO_REPROXY_PORT="${GO_REPROXY_PORT:-7999}" \
    nohup "${ENTRYPOINT}" >> "${LOG_FILE}" 2>&1 &
    PID=$!
    printf '%s\n' "${PID}" > "${PID_FILE}"

    attempts=0
    while [ "${attempts}" -lt 20 ]; do
        if ! kill -0 "${PID}" 2>/dev/null; then
            rm -f "${PID_FILE}"
            printf 'fn-knock exited during startup; see %s\n' "${LOG_FILE}" > "${SYNOPKG_TEMP_LOGFILE:-/dev/null}"
            return 1
        fi
        if curl -fsS "http://127.0.0.1:${BACKEND_PORT}/" >/dev/null 2>&1; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done

    kill "${PID}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    printf 'fn-knock health check timed out; see %s\n' "${LOG_FILE}" > "${SYNOPKG_TEMP_LOGFILE:-/dev/null}"
    return 1
}

stop_service() {
    if ! pid_is_running; then
        rm -f "${PID_FILE}"
        return 0
    fi
    kill "${PID}" 2>/dev/null || true
    attempts=0
    while kill -0 "${PID}" 2>/dev/null && [ "${attempts}" -lt 30 ]; do
        attempts=$((attempts + 1))
        sleep 1
    done
    if kill -0 "${PID}" 2>/dev/null; then
        kill -KILL "${PID}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    status)
        if pid_is_running; then
            exit 0
        fi
        [ -e "${PID_FILE}" ] && exit 1
        exit 3
        ;;
    prestart)
        [ -x "${ENTRYPOINT}" ] || {
            printf 'Missing executable: %s\n' "${ENTRYPOINT}" > "${SYNOPKG_TEMP_LOGFILE:-/dev/null}"
            exit 1
        }
        ;;
    prestop) ;;
    *) exit 1 ;;
esac

exit $?
