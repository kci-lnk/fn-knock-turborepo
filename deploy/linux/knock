require_root() {
  [ "$(id -u)" -eq 0 ] || fail "需要 root 权限，请运行：sudo knock $*"
}

load_local_env() {
  if [ -f "${ENV_FILE}" ]; then
    set -a
    # shellcheck disable=SC1090
    . "${ENV_FILE}"
    set +a
  fi
  FN_KNOCK_BASE_URL="${FN_KNOCK_BASE_URL:-${DEFAULT_BASE_URL}}"
}

cache_bust_url() {
  local url="$1" separator="?"
  case "${url}" in *\?*) separator="&" ;; esac
  printf '%s%scb=%s-%s-%s\n' "${url}" "${separator}" "$(date +%s)" "$$" "${RANDOM}"
}

normalize_arch() {
  case "${1:-$(uname -m)}" in
    x86_64|amd64) printf '%s\n' amd64 ;;
    aarch64|arm64) printf '%s\n' arm64 ;;
    armv7l|armv8l|armhf|arm) printf '%s\n' arm ;;
    *) return 1 ;;
  esac
}

download_file() {
  local url="$1"
  local output="$2"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location --retry 3 --connect-timeout 15 \
      -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' -o "${output}" "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --tries=3 --timeout=30 --header='Cache-Control: no-cache' --header='Pragma: no-cache' -O "${output}" "${url}"
  else
    fail "需要安装 curl 或 wget"
  fi
}

manifest_value() {
  local file="$1"
  local key="$2"
  awk -v wanted="${key}" '
    index($0, wanted "=") == 1 {
      count++
      value = substr($0, length(wanted) + 2)
    }
    END {
      if (count != 1) exit 1
      print value
    }
  ' "${file}"
}

validate_manifest() {
  MANIFEST_VERSION="$(manifest_value "$1" VERSION)" || fail "线上清单中的 VERSION 缺失或重复"
  MANIFEST_URL="$(manifest_value "$1" URL)" || fail "线上清单中的 URL 缺失或重复"
  MANIFEST_SHA256="$(manifest_value "$1" SHA256)" || fail "线上清单中的 SHA256 缺失或重复"
  MANIFEST_SIZE="$(manifest_value "$1" SIZE)" || fail "线上清单中的 SIZE 缺失或重复"

  printf '%s' "${MANIFEST_VERSION}" | grep -Eq '^[0-9][0-9A-Za-z._+-]*$' || fail "线上清单版本号无效"
  printf '%s' "${MANIFEST_SHA256}" | grep -Eq '^[0-9a-fA-F]{64}$' || fail "线上清单 SHA256 无效"
  printf '%s' "${MANIFEST_SIZE}" | grep -Eq '^[1-9][0-9]*$' || fail "线上清单文件大小无效"
  case "${MANIFEST_URL}" in
    https://*) ;;
    http://*) [ "${FN_KNOCK_ALLOW_INSECURE_HTTP:-0}" = "1" ] || fail "线上清单 URL 必须使用 HTTPS" ;;
    *) fail "线上清单 URL 必须为绝对地址" ;;
  esac
}

file_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    fail "需要安装 sha256sum 或 openssl"
  fi
}

fetch_release() {
  local arch="$1"
  DOWNLOAD_DIR="$(mktemp -d /tmp/fn-knock-download.XXXXXX)"
  local manifest="${DOWNLOAD_DIR}/latest.env"
  local archive="${DOWNLOAD_DIR}/release.tar.gz"
  local base="${FN_KNOCK_BASE_URL%/}"

  log "正在从线上获取最新版本信息（已绕过 CDN 缓存）…"
  download_file "$(cache_bust_url "${base}/linux/latest/${arch}.env")" "${manifest}"
  validate_manifest "${manifest}"
  download_file "${MANIFEST_URL}" "${archive}"

  local actual_size actual_sha
  actual_size="$(wc -c < "${archive}" | tr -d '[:space:]')"
  [ "${actual_size}" = "${MANIFEST_SIZE}" ] || fail "下载文件大小不匹配：应为 ${MANIFEST_SIZE}，实际为 ${actual_size}"
  actual_sha="$(file_sha256 "${archive}")"
  [ "${actual_sha}" = "${MANIFEST_SHA256}" ] || fail "下载文件 SHA256 校验不匹配"

  tar --warning=no-unknown-keyword --warning=no-timestamp -tzf "${archive}" > "${DOWNLOAD_DIR}/archive.list"
  grep -qx 'fn-knock/release.json' "${DOWNLOAD_DIR}/archive.list" || fail "发布包目录结构无效"
  tar --warning=no-unknown-keyword --warning=no-timestamp -xzf "${archive}" -C "${DOWNLOAD_DIR}"
  DOWNLOADED_SOURCE="${DOWNLOAD_DIR}/fn-knock"
  [ -x "${DOWNLOADED_SOURCE}/bin/knock" ] || fail "发布包缺少 knock 管理命令"
}

release_version() {
  local release_dir="$1"
  sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "${release_dir}/release.json" | head -n1
}

current_version() {
  if [ -f "${CURRENT_LINK}/release.json" ]; then
    release_version "${CURRENT_LINK}"
  else
    printf '%s\n' unknown
  fi
}

atomic_link() {
  local target="$1"
  local link="$2"
  local temporary="${link}.new.$$"
  ln -s "${target}" "${temporary}"
  mv -Tf "${temporary}" "${link}"
}

install_management_files() {
  local release_dir="$1"
  local command_tmp="${COMMAND_FILE}.new.$$"
  local unit_tmp="${UNIT_FILE}.new.$$"
  install -m 0755 "${release_dir}/bin/knock" "${command_tmp}"
  mv -f "${command_tmp}" "${COMMAND_FILE}"
  install -m 0644 "${release_dir}/systemd/fn-knock.service" "${unit_tmp}"
  mv -f "${unit_tmp}" "${UNIT_FILE}"
  systemctl daemon-reload
}

snapshot_link_state() {
  local path="$1" name="$2" snapshot_dir="$3"
  if [ -L "${path}" ]; then
    readlink "${path}" > "${snapshot_dir}/${name}.link"
  elif [ -e "${path}" ]; then
    warn "事务期间拒绝替换非符号链接路径：${path}"
    return 1
  else
    : > "${snapshot_dir}/${name}.absent"
  fi
}

snapshot_file_state() {
  local path="$1" name="$2" snapshot_dir="$3"
  if [ -f "${path}" ]; then
    cp -p "${path}" "${snapshot_dir}/${name}.file"
  elif [ -e "${path}" ] || [ -L "${path}" ]; then
    warn "事务期间拒绝替换非普通管理文件：${path}"
    return 1
  else
    : > "${snapshot_dir}/${name}.absent"
  fi
}

create_transaction_snapshot() {
  local snapshot_dir="$1"
  snapshot_link_state "${CURRENT_LINK}" current "${snapshot_dir}" || return 1
  snapshot_link_state "${PREVIOUS_LINK}" previous "${snapshot_dir}" || return 1
  snapshot_file_state "${COMMAND_FILE}" command "${snapshot_dir}" || return 1
  snapshot_file_state "${UNIT_FILE}" unit "${snapshot_dir}" || return 1

  if systemctl is-enabled --quiet "${SERVICE_NAME}" >/dev/null 2>&1; then
    printf '%s\n' enabled > "${snapshot_dir}/service.enabled"
  else
    printf '%s\n' disabled > "${snapshot_dir}/service.enabled"
  fi
  if systemctl is-active --quiet "${SERVICE_NAME}" >/dev/null 2>&1; then
    printf '%s\n' active > "${snapshot_dir}/service.active"
  else
    printf '%s\n' inactive > "${snapshot_dir}/service.active"
  fi
}

restore_link_state() {
  local path="$1" name="$2" snapshot_dir="$3"
  if [ -f "${snapshot_dir}/${name}.link" ]; then
    atomic_link "$(< "${snapshot_dir}/${name}.link")" "${path}"
  else
    rm -f "${path}"
  fi
}

restore_file_state() {
  local path="$1" name="$2" snapshot_dir="$3"
  local temporary="${path}.restore.$$"
  if [ -f "${snapshot_dir}/${name}.file" ]; then
    cp -p "${snapshot_dir}/${name}.file" "${temporary}" || return 1
    mv -f "${temporary}" "${path}" || { rm -f "${temporary}"; return 1; }
  else
    rm -f "${path}"
  fi
}

restore_transaction_snapshot() {
  local snapshot_dir="$1"
  local enabled_state active_state restore_failed=0
  enabled_state="$(< "${snapshot_dir}/service.enabled")"
  active_state="$(< "${snapshot_dir}/service.active")"

  # Stop a possibly running candidate before restoring its executable links.
  if ! systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1; then
    if systemctl is-active --quiet "${SERVICE_NAME}" >/dev/null 2>&1; then
      warn "恢复时无法停止候选服务"
      restore_failed=1
    fi
  fi
  if [ "${enabled_state}" = "disabled" ]; then
    if ! systemctl disable "${SERVICE_NAME}" >/dev/null 2>&1; then
      if systemctl is-enabled --quiet "${SERVICE_NAME}" >/dev/null 2>&1; then
        warn "无法恢复服务的禁用状态"
        restore_failed=1
      fi
    fi
  fi

  restore_link_state "${CURRENT_LINK}" current "${snapshot_dir}" || restore_failed=1
  restore_link_state "${PREVIOUS_LINK}" previous "${snapshot_dir}" || restore_failed=1
  restore_file_state "${COMMAND_FILE}" command "${snapshot_dir}" || restore_failed=1
  restore_file_state "${UNIT_FILE}" unit "${snapshot_dir}" || restore_failed=1

  if ! systemctl daemon-reload; then
    warn "恢复上一版本时 systemd daemon-reload 失败"
    restore_failed=1
  fi
  if [ "${enabled_state}" = "enabled" ] && ! systemctl enable "${SERVICE_NAME}" >/dev/null; then
    warn "无法恢复服务的启用状态"
    restore_failed=1
  fi
  if [ "${active_state}" = "active" ]; then
    if ! systemctl start "${SERVICE_NAME}"; then
      warn "无法恢复服务的运行状态"
      restore_failed=1
    fi
  else
    systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1 || true
    systemctl reset-failed "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi

  return "${restore_failed}"
}

wait_for_health() {
  load_local_env
  local port="${ADMIN_VIEW_PORT:-7991}"
  local attempts="${FN_KNOCK_HEALTH_ATTEMPTS:-30}"
  local i
  for ((i = 1; i <= attempts; i++)); do
    if curl --fail --silent --max-time 2 "http://127.0.0.1:${port}/api/admin/healthz" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

ensure_default_config() {
  local release_dir="$1"
  mkdir -p "${CONFIG_DIR}/gateway" "${DATA_DIR}" "${RELEASES_DIR}"
  chmod 700 "${CONFIG_DIR}" "${DATA_DIR}" 2>/dev/null || true
  if [ ! -f "${ENV_FILE}" ]; then
    install -m 0600 "${release_dir}/config/fn-knock.env" "${ENV_FILE}"
  else
    chmod 600 "${ENV_FILE}"
  fi
}

cleanup_releases() {
  local current previous keep_extra=""
  current="$(readlink -f "${CURRENT_LINK}" 2>/dev/null || true)"
  previous="$(readlink -f "${PREVIOUS_LINK}" 2>/dev/null || true)"
  while IFS= read -r dir; do
    [ -n "${dir}" ] || continue
    if [ "${dir}" = "${current}" ] || [ "${dir}" = "${previous}" ]; then
      continue
    fi
    if [ -z "${keep_extra}" ]; then
      keep_extra="${dir}"
      continue
    fi
    rm -rf -- "${dir}"
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | xargs -0 -r ls -1dt 2>/dev/null || true)
}

install_release() {
  local source_dir="$1"
  local version="$2"
  local force_reinstall="${3:-0}"
  local target_name="${version}"
  if [ "${force_reinstall}" = "1" ] && [ -d "${RELEASES_DIR}/${target_name}" ]; then
    target_name="${version}.reinstall.$(date +%s).$$"
  fi
  local target_dir="${RELEASES_DIR}/${target_name}"
  local stage_dir="${RELEASES_DIR}/.${target_name}.new.$$"
  local old_current="" transaction_dir transaction_status

  [ "$(release_version "${source_dir}")" = "${version}" ] || fail "发布包 release.json 的版本与 ${version} 不一致"
  mkdir -p "${RELEASES_DIR}"
  if [ ! -d "${target_dir}" ]; then
    rm -rf "${stage_dir}"
    mkdir -p "${stage_dir}"
    cp -a "${source_dir}/." "${stage_dir}/"
    chmod 0755 "${stage_dir}/bin/knock" "${stage_dir}/bin/fn-knock-entrypoint" \
      "${stage_dir}/bin/go-reauth-proxy" "${stage_dir}/bin/server-admin-rs"
    mv "${stage_dir}" "${target_dir}"
  fi

  ensure_default_config "${target_dir}"
  old_current="$(readlink -f "${CURRENT_LINK}" 2>/dev/null || true)"
  transaction_dir="$(mktemp -d "${TMPDIR:-/tmp}/fn-knock-transaction.XXXXXX")"
  if ! create_transaction_snapshot "${transaction_dir}"; then
    rm -rf "${transaction_dir}"
    fail "切换版本前无法创建当前安装快照"
  fi

  # Run the mutation in an errexit-enabled subshell while the parent retains
  # control and can restore every externally visible state on any failure.
  set +e
  (
    set -e
    if [ -n "${old_current}" ] && [ "${old_current}" != "${target_dir}" ]; then
      atomic_link "${old_current}" "${PREVIOUS_LINK}"
    fi
    atomic_link "${target_dir}" "${CURRENT_LINK}"
    install_management_files "${target_dir}"
    systemctl enable "${SERVICE_NAME}" >/dev/null
    systemctl restart "${SERVICE_NAME}"
    wait_for_health
  )
  transaction_status=$?
  set -e

  if [ "${transaction_status}" -ne 0 ]; then
    journalctl -u "${SERVICE_NAME}" -n 80 --no-pager >&2 || true
    warn "新版本启动失败，正在恢复链接、管理命令、服务配置和运行状态"
    if ! restore_transaction_snapshot "${transaction_dir}"; then
      rm -rf "${transaction_dir}"
      fail "版本 ${version} 启动失败，且无法完整恢复上一安装状态"
    fi
    rm -rf "${transaction_dir}"
    fail "版本 ${version} 启动失败，已恢复上一版本"
  fi

  rm -rf "${transaction_dir}"
  cleanup_releases
  success "版本 ${version} 已启动运行"
}

PORT_KEYS=(GO_REPROXY_PORT ADMIN_VIEW_PORT BACKEND_PORT AUTH_PORT GO_BACKEND_PORT)
PORT_LABELS=("Go 代理服务（对外 · 重要）" "管理面板（对外）" "管理后端（仅本机）" "认证服务（仅本机）" "Go 管理接口（仅本机）")
PORT_DEFAULTS=(7999 7991 7998 7997 7996)
PORT_VALUES=()
CURRENT_PORT_VALUES=()

port_valid() { printf '%s' "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

read_tty() {
  local prompt="$1"
  read -r -p "${prompt}" REPLY </dev/tty || fail "需要可交互的终端"
}

load_port_values() {
  PORT_VALUES=(
    "${GO_REPROXY_PORT:-7999}"
    "${ADMIN_VIEW_PORT:-7991}"
    "${BACKEND_PORT:-7998}"
    "${AUTH_PORT:-7997}"
    "${GO_BACKEND_PORT:-7996}"
  )
  CURRENT_PORT_VALUES=("${PORT_VALUES[@]}")
}

port_listener_details() {
  local port="$1"
  command -v ss >/dev/null 2>&1 || fail "无法检测端口：请先安装 iproute2（提供 ss 命令）"
  # The ss filter matches IPv4 and IPv6 listeners without relying on a
  # particular address-column format.
  ss -H -ltn "sport = :${port}" 2>/dev/null | sed '/^[[:space:]]*$/d' || true
}

port_is_current_running_listener() {
  local index="$1" port="$2"
  systemctl is-active --quiet "${SERVICE_NAME}" >/dev/null 2>&1 && \
    [ "${CURRENT_PORT_VALUES[${index}]}" = "${port}" ]
}

validate_port_plan() {
  local i j port details conflicts=0
  for ((i = 0; i < ${#PORT_VALUES[@]}; i++)); do
    port="${PORT_VALUES[${i}]}"
    port_valid "${port}" || { warn "${PORT_LABELS[${i}]} 的端口无效：${port}"; return 1; }
    for ((j = 0; j < i; j++)); do
      [ "${PORT_VALUES[${j}]}" != "${port}" ] || {
        warn "端口 ${port} 同时分配给 ${PORT_LABELS[${j}]} 和 ${PORT_LABELS[${i}]}"
        return 1
      }
    done
  done

  for ((i = 0; i < ${#PORT_VALUES[@]}; i++)); do
    port="${PORT_VALUES[${i}]}"
    details="$(port_listener_details "${port}")"
    [ -z "${details}" ] && continue
    if port_is_current_running_listener "${i}" "${port}"; then
      continue
    fi
    warn "端口 ${port} 已被占用，无法用于 ${PORT_LABELS[${i}]}："
    printf '%s\n' "${details}" >&2
    conflicts=1
  done
  [ "${conflicts}" = "0" ]
}

show_port_plan() {
  local i
  printf '\n%s━━━ 端口配置 ━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  for ((i = 0; i < ${#PORT_VALUES[@]}; i++)); do
    printf '  %s[%d]%s %-28s %s%s%s\n' \
      "${C_ACCENT}" "$((i + 1))" "${C_RESET}" "${PORT_LABELS[${i}]}" \
      "${C_OK}" "${PORT_VALUES[${i}]}" "${C_RESET}"
  done
  printf '%s  提示：管理面板和 Go 代理监听所有网卡；其余服务仅监听本机。%s\n' "${C_DIM}" "${C_RESET}"
}

change_port() {
  local index="$1" value details
  while true; do
    read_tty "${PORT_LABELS[${index}]} 的端口 [${PORT_VALUES[${index}]}]: "
    value="${REPLY:-${PORT_VALUES[${index}]}}"
    if ! port_valid "${value}"; then
      warn "端口必须是 1 到 65535 之间的数字"
      continue
    fi
    details="$(port_listener_details "${value}")"
    if [ -n "${details}" ] && ! port_is_current_running_listener "${index}" "${value}"; then
      warn "端口 ${value} 已被占用："
      printf '%s\n' "${details}" >&2
      continue
    fi
    PORT_VALUES[${index}]="${value}"
    return
  done
}

write_port_config() {
  local temporary="${ENV_FILE}.new.$$"
  mkdir -p "${CONFIG_DIR}"
  umask 077
  if [ -f "${ENV_FILE}" ]; then
    awk \
      -v proxy="${PORT_VALUES[0]}" -v admin="${PORT_VALUES[1]}" \
      -v backend="${PORT_VALUES[2]}" -v auth="${PORT_VALUES[3]}" -v go_admin="${PORT_VALUES[4]}" '
      BEGIN {
        value["ADMIN_VIEW_PORT"] = admin
        value["BACKEND_PORT"] = backend
        value["AUTH_PORT"] = auth
        value["GO_BACKEND_PORT"] = go_admin
        value["GO_REPROXY_PORT"] = proxy
      }
      $0 ~ /^(ADMIN_VIEW_PORT|BACKEND_PORT|AUTH_PORT|GO_BACKEND_PORT|GO_REPROXY_PORT)=/ {
        split($0, parts, "=")
        print parts[1] "=" value[parts[1]]
        seen[parts[1]] = 1
        next
      }
      { print }
      END {
        for (key in value) if (!seen[key]) print key "=" value[key]
      }
    ' "${ENV_FILE}" > "${temporary}"
  else
    cat > "${temporary}" <<EOF
FN_KNOCK_RUNTIME_TARGET=linux
FN_KNOCK_DATA_DIR=/var/lib/fn-knock
FN_KNOCK_GATEWAY_CONFIG_DIR=/etc/fn-knock/gateway
FN_KNOCK_BASE_URL=${FN_KNOCK_BASE_URL:-${DEFAULT_BASE_URL}}
GO_REPROXY_PORT=${PORT_VALUES[0]}
ADMIN_VIEW_PORT=${PORT_VALUES[1]}
BACKEND_PORT=${PORT_VALUES[2]}
AUTH_PORT=${PORT_VALUES[3]}
GO_BACKEND_PORT=${PORT_VALUES[4]}
ADMIN_VIEW_HOST=0.0.0.0
BACKEND_HOST=127.0.0.1
AUTH_HOST=127.0.0.1
EOF
  fi
  mv -f "${temporary}" "${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
  success "端口配置已保存到 ${ENV_FILE}"
}

configure_ports_menu() {
  local choice index
  while true; do
    show_port_plan
    cat <<'EOF'

输入端口编号 [1-5] 修改对应端口
S. 校验并保存    R. 恢复默认端口    0. 取消
EOF
    read_tty "请选择: "
    choice="${REPLY}"
    case "${choice}" in
      1|2|3|4|5)
        index="$((choice - 1))"
        change_port "${index}"
        ;;
      r|R)
        PORT_VALUES=("${PORT_DEFAULTS[@]}")
        log "已恢复默认端口；保存前仍会检查是否被占用"
        ;;
      s|S)
        if validate_port_plan; then
          write_port_config
          return 0
        fi
        warn "请修改冲突端口后再保存"
        ;;
      0) return 1 ;;
      *) warn "无效选择" ;;
    esac
  done
}

config_command() {
  require_root config
  load_local_env
  load_port_values
  if ! configure_ports_menu; then
    log "端口配置未变更"
    return
  fi
  read_tty "现在重启服务以应用新端口？[Y/n] "
  if [ "${REPLY:-Y}" != "n" ] && [ "${REPLY:-Y}" != "N" ]; then
    systemctl restart "${SERVICE_NAME}"
    wait_for_health || fail "端口修改后服务健康检查失败"
  else
    warn "端口配置已保存，服务仍在使用旧端口；请稍后执行 sudo knock restart"
  fi
}

format_memory() {
  local kib="${1:-0}"
  awk -v kib="${kib}" 'BEGIN {
    if (kib >= 1048576) printf "%.2f GiB", kib / 1048576;
    else if (kib >= 1024) printf "%.1f MiB", kib / 1024;
    else printf "%d KiB", kib;
  }'
}

show_process_memory() {
  local process_name="$1" label="$2" rows pid rss elapsed total_rss=0 count=0
  rows="$(ps -C "${process_name}" -o pid=,rss=,etime= 2>/dev/null || true)"
  if [ -z "${rows//[[:space:]]/}" ]; then
    printf '  %-24s %s未运行%s\n' "${label}" "${C_ERR}" "${C_RESET}"
    return
  fi

  while read -r pid rss elapsed; do
    [ -n "${pid:-}" ] || continue
    total_rss=$((total_rss + rss))
    count=$((count + 1))
    printf '  %-24s %s运行中%s  PID: %-7s RSS: %-10s 已运行: %s\n' \
      "${label}" "${C_OK}" "${C_RESET}" "${pid}" "$(format_memory "${rss}")" "${elapsed}"
  done <<< "${rows}"
  PROCESS_TOTAL_RSS=$((PROCESS_TOTAL_RSS + total_rss))
  PROCESS_TOTAL_COUNT=$((PROCESS_TOTAL_COUNT + count))
}

show_listener_status() {
  local label="$1" process_name="$2" port="$3" details
  printf '  %-24s 配置端口：%s%s%s\n' \
    "${label}" "${C_OK}" "${port}" "${C_RESET}"
  if ! command -v ss >/dev/null 2>&1; then
    printf '  %s  无法读取实际监听状态：缺少 ss 命令%s\n' "${C_DIM}" "${C_RESET}"
    return
  fi
  details="$(ss -H -ltnp "sport = :${port}" 2>/dev/null || true)"
  if [ -z "${details//[[:space:]]/}" ]; then
    printf '  %s  实际监听：未发现 %s 的 TCP 监听%s\n' \
      "${C_ERR}" "${process_name}" "${C_RESET}"
    return
  fi
  printf '  %s  实际监听：%s\n' "${C_OK}" "${C_RESET}"
  printf '%s\n' "${details}" | sed 's/^/    /'
}

status_command() {
  local active enabled main_pid exec_status since admin_port proxy_port
  log "正在收集运行状态…"
  load_local_env
  admin_port="${ADMIN_VIEW_PORT:-7991}"
  proxy_port="${GO_REPROXY_PORT:-7999}"
  active="$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "${SERVICE_NAME}" 2>/dev/null || true)"
  main_pid="$(systemctl show "${SERVICE_NAME}" -p MainPID --value 2>/dev/null || true)"
  exec_status="$(systemctl show "${SERVICE_NAME}" -p ExecMainStatus --value 2>/dev/null || true)"
  since="$(systemctl show "${SERVICE_NAME}" -p ActiveEnterTimestamp --value 2>/dev/null || true)"

  printf '\n%s━━━ 服务状态 ━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  if [ "${active}" = "active" ]; then
    printf '  服务：%s运行中%s    开机启动：%s\n' "${C_OK}" "${C_RESET}" "${enabled:-未知}"
  else
    printf '  服务：%s%s%s    开机启动：%s\n' "${C_ERR}" "${active:-未知}" "${C_RESET}" "${enabled:-未知}"
  fi
  printf '  systemd 主 PID：%s    最近退出码：%s\n' "${main_pid:-无}" "${exec_status:-未知}"
  [ -z "${since}" ] || printf '  本次启动时间：%s\n' "${since}"

  printf '\n%s━━━ 对外监听端口 ━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  show_listener_status "go-reauth-proxy（网关）" "go-reauth-proxy" "${proxy_port}"
  show_listener_status "server-admin-rs（管理面板）" "server-admin-rs" "${admin_port}"

  printf '\n%s━━━ 核心进程内存（RSS）━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  PROCESS_TOTAL_RSS=0
  PROCESS_TOTAL_COUNT=0
  show_process_memory "server-admin-rs" "server-admin-rs"
  show_process_memory "go-reauth-proxy" "go-reauth-proxy"
  printf '  %s合计：%d 个进程，RSS %s%s\n' \
    "${C_TITLE}" "${PROCESS_TOTAL_COUNT}" "$(format_memory "${PROCESS_TOTAL_RSS}")" "${C_RESET}"

  printf '\n%s━━━ systemctl 摘要 ━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  systemctl status "${SERVICE_NAME}" --no-pager --lines=8 || true
}

service_action() {
  local action="$1" action_name="$2" state
  log "正在${action_name}服务…"
  if systemctl "${action}" "${SERVICE_NAME}"; then
    state="$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || true)"
    success "服务${action_name}完成，当前状态：${state:-未知}"
  else
    warn "服务${action_name}失败，请执行 sudo knock status 或 sudo knock logs 查看详情"
  fi
}

reset_panel_password_command() {
  require_root reset-panel-password
  load_local_env
  local backend="${CURRENT_LINK}/bin/server-admin-rs"
  [ -x "${backend}" ] || fail "未找到可执行的管理后端：${backend}"
  read_tty "将清除面板密码、所有登录会话和失败退避记录；确认继续？[y/N] "
  case "${REPLY:-N}" in
    y|Y) ;;
    *) log "已取消清除面板登录密码"; return ;;
  esac
  log "正在清除面板登录密码…"
  FN_KNOCK_RUNTIME_TARGET=linux \
    FN_KNOCK_DATA_DIR="${FN_KNOCK_DATA_DIR:-${DATA_DIR}}" \
    FN_KNOCK_GATEWAY_CONFIG_DIR="${FN_KNOCK_GATEWAY_CONFIG_DIR:-${CONFIG_DIR}/gateway}" \
    FN_KNOCK_LOCALE=zh-CN \
    "${backend}" reset-panel-password
  success "面板登录密码已清除；下次访问管理面板时请重新设置密码"
}

prepare_install_command() {
  require_root install
  local answer has_config=0 installed=0
  [ -f "${ENV_FILE}" ] && has_config=1
  [ -e "${CURRENT_LINK}" ] && installed=1
  load_local_env
  load_port_values

  if [ "${has_config}" = "1" ]; then
    if [ "${installed}" = "1" ]; then
      log "检测到已安装实例的端口配置"
    else
      warn "未检测到已安装实例，但发现残留端口配置：${ENV_FILE}"
    fi
    show_port_plan
    cat <<'EOF'

1. 沿用并校验现有端口配置
2. 修改现有端口配置
3. 清除旧端口配置，恢复默认端口
0. 取消安装
EOF
    read_tty "请选择 [1]: "
    case "${REPLY:-1}" in
      1)
        if validate_port_plan; then
          return
        fi
        warn "现有端口配置无法直接使用，请修改或恢复默认端口"
        configure_ports_menu || fail "安装已取消，端口配置未保存"
        return
        ;;
      2)
        configure_ports_menu || fail "安装已取消，端口配置未保存"
        return
        ;;
      3)
        rm -f "${ENV_FILE}"
        PORT_VALUES=("${PORT_DEFAULTS[@]}")
        # A deleted configuration must not treat a running service as owning
        # the new defaults; every default port is checked again below.
        CURRENT_PORT_VALUES=("" "" "" "" "")
        log "已清除旧端口配置；正在检查默认端口"
        if validate_port_plan; then
          write_port_config
          return
        fi
        warn "默认端口存在冲突，请选择要修改的端口"
        configure_ports_menu || fail "安装已取消，端口配置未保存"
        return
        ;;
      0) fail "已取消安装" ;;
      *) fail "无效选择，请输入菜单中的编号" ;;
    esac
  else
    log "正在检查首次安装的默认端口"
    if validate_port_plan; then
      read_tty "默认端口均可用，使用默认配置？[Y/n] "
      if [ "${REPLY:-Y}" != "n" ] && [ "${REPLY:-Y}" != "N" ]; then
        write_port_config
        return
      fi
    else
      warn "检测到端口冲突；请为冲突服务选择其他端口"
    fi
  fi

  configure_ports_menu || fail "安装已取消，端口配置未保存"
}

update_command() {
  require_root update
  load_local_env
  local arch installed answer force_reinstall=0
  arch="$(normalize_arch)" || fail "不支持的系统架构：$(uname -m)"
  installed="$(current_version)"
  fetch_release "${arch}"
  trap 'rm -rf "${DOWNLOAD_DIR:-}"' EXIT

  printf '\n%s━━━ 版本检查 ━━━%s\n' "${C_ACCENT}" "${C_RESET}"
  printf '  本地版本：%s%s%s\n' "${C_OK}" "${installed}" "${C_RESET}"
  printf '  线上版本：%s%s%s\n' "${C_ACCENT}" "${MANIFEST_VERSION}" "${C_RESET}"
  if [ "${installed}" = "${MANIFEST_VERSION}" ]; then
    log "本地已是线上版本 ${installed}"
    force_reinstall=1
    if [ "${1:-}" != "--yes" ]; then
      read_tty "仍要重新下载并部署该版本吗？[y/N] "
      case "${REPLY:-N}" in
        y|Y) ;;
        *) log "已取消更新"; return ;;
      esac
    fi
  elif [ "${1:-}" != "--yes" ]; then
    read_tty "确认升级 ${installed} -> ${MANIFEST_VERSION}？[Y/n] "
    answer="${REPLY}"
    [ "${answer:-Y}" != "n" ] && [ "${answer:-Y}" != "N" ] || return
  fi
  log "正在部署版本 ${MANIFEST_VERSION}…"
  install_release "${DOWNLOADED_SOURCE}" "${MANIFEST_VERSION}" "${force_reinstall}"
}

rollback_command() {
  require_root rollback
  [ -L "${PREVIOUS_LINK}" ] || fail "没有可回滚的上一版本"
  local current previous transaction_dir transaction_status
  current="$(readlink -f "${CURRENT_LINK}")"
  previous="$(readlink -f "${PREVIOUS_LINK}")"
  [ -d "${previous}" ] || fail "上一版本目录不存在"

  transaction_dir="$(mktemp -d "${TMPDIR:-/tmp}/fn-knock-transaction.XXXXXX")"
  if ! create_transaction_snapshot "${transaction_dir}"; then
    rm -rf "${transaction_dir}"
    fail "回滚前无法创建当前安装快照"
  fi

  set +e
  (
    set -e
    atomic_link "${previous}" "${CURRENT_LINK}"
    atomic_link "${current}" "${PREVIOUS_LINK}"
    install_management_files "${previous}"
    systemctl restart "${SERVICE_NAME}"
    wait_for_health
  )
  transaction_status=$?
  set -e

  if [ "${transaction_status}" -ne 0 ]; then
    warn "回滚目标启动失败，正在恢复回滚前的安装状态"
    if ! restore_transaction_snapshot "${transaction_dir}"; then
      rm -rf "${transaction_dir}"
      fail "回滚失败，且无法完整恢复回滚前的安装状态"
    fi
    rm -rf "${transaction_dir}"
    fail "回滚目标启动失败，已恢复回滚前版本"
  fi

  rm -rf "${transaction_dir}"
  success "已回滚到版本 $(release_version "${previous}")"
}

uninstall_command() {
  require_root uninstall
  local purge=0 yes=0 answer
  for arg in "$@"; do
    [ "${arg}" = "--purge" ] && purge=1
    [ "${arg}" = "--yes" ] && yes=1
  done
  if [ "${yes}" != "1" ]; then
    warn "将卸载 fn-knock 程序和 systemd 服务；配置与数据会保留"
    read_tty "确认卸载？请输入 Y 继续："
    [ "${REPLY:-}" = "y" ] || [ "${REPLY:-}" = "Y" ] || { log "已取消卸载"; return; }
  fi
  if [ "${purge}" = "1" ]; then
    [ -t 0 ] || fail "彻底清除需要可交互终端和独立的 DELETE 确认"
    if ! read -r -p "输入 DELETE 确认永久删除配置和数据: " answer </dev/tty; then
      fail "彻底清除需要可交互终端和独立的 DELETE 确认"
    fi
    [ "${answer}" = "DELETE" ] || fail "已取消彻底清除"
  fi
  log "正在停止并移除 fn-knock 服务…"
  systemctl disable --now "${SERVICE_NAME}" >/dev/null 2>&1 || true
  rm -f "${UNIT_FILE}"
  systemctl daemon-reload
  rm -rf "${APP_ROOT}"
  if [ "${purge}" = "1" ]; then
    rm -rf "${CONFIG_DIR}" "${DATA_DIR}"
    success "程序、配置和数据已全部移除"
  else
    success "程序已移除，配置和数据已保留"
  fi
  rm -f "${COMMAND_FILE}"
}

nginx_command() {
  load_local_env
  local port="${ADMIN_VIEW_PORT:-7991}"
  cat <<EOF
# ${port} 是 fn-knock 控制面入口，默认监听所有网卡。
# 如需从公网访问，请通过 Nginx 提供 HTTPS，并设置访问控制；请替换域名和证书路径。
server {
    listen 443 ssl http2;
    server_name knock.example.com;

    ssl_certificate     /etc/nginx/ssl/knock.example.com.fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/knock.example.com.key;

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# 保存后先执行 nginx -t，再执行 systemctl reload nginx。
# 不要直接将 ${port} 暴露到公网；公网入口应使用 HTTPS 和访问控制。
EOF
}

show_menu() {
  while true; do
    show_banner
    printf '\n%s━━━ 管理菜单 ━━━%s  当前版本：%s%s%s\n' \
      "${C_ACCENT}" "${C_RESET}" "${C_OK}" "$(current_version)" "${C_RESET}"
    cat <<'EOF'
1. 重启服务
2. 配置端口
3. 查看运行状态与内存占用
4. 启动服务
5. 停止服务
6. 查看/跟随日志
7. 检查并安装更新
8. 回滚上一版本
9. 卸载 fn-knock（保留配置和数据）
10. 查看 Nginx 反向代理示例
11. 清除面板登录密码
0. 退出
EOF
    read_tty "请选择: "
    choice="${REPLY}"
    case "${choice}" in
      1) service_action restart "重启" ;;
      2) config_command ;;
      3) status_command ;;
      4) service_action start "启动" ;;
      5) service_action stop "停止" ;;
      6) log "正在显示服务日志（按 Ctrl+C 返回菜单）…"; journalctl -u "${SERVICE_NAME}" -n 100 -f || true ;;
      7) update_command ;;
      8) rollback_command ;;
      9) uninstall_command; return ;;
      10) log "Nginx 反向代理配置示例："; nginx_command ;;
      11) reset_panel_password_command ;;
      0) return ;;
      *) warn "无效选择，请输入菜单中的编号" ;;
    esac
    printf '\n%s按 Enter 返回管理菜单…%s' "${C_DIM}" "${C_RESET}"
    read -r _ </dev/tty || true
  done
}

case "${1:-}" in
  "") require_root; show_menu ;;
  restart) require_root restart; service_action restart "重启" ;;
  config) config_command ;;
  status) status_command ;;
  start) require_root start; service_action start "启动" ;;
  stop) require_root stop; service_action stop "停止" ;;
  logs)
    shift
    if [ "${1:-}" = "--follow" ] || [ "${1:-}" = "-f" ]; then
      log "正在跟随服务日志（按 Ctrl+C 退出）…"
      journalctl -u "${SERVICE_NAME}" -n 100 -f
    else
      log "最近 100 行服务日志："
      journalctl -u "${SERVICE_NAME}" -n 100 --no-pager
    fi
    ;;
  update) shift; update_command "$@" ;;
  rollback) rollback_command ;;
  uninstall) shift; uninstall_command "$@" ;;
  nginx) log "Nginx 反向代理配置示例："; nginx_command ;;
  reset-panel-password|reset-admin-panel-password) reset_panel_password_command ;;
  version) current_version ;;
  _install-extracted)
    require_root install
    [ "$#" -ge 3 ] || fail "安装器内部参数缺失"
    install_release "$2" "$3"
    ;;
  _prepare-install) prepare_install_command ;;
  *) fail "用法：knock [restart|config|status|start|stop|logs|update|rollback|uninstall|nginx|reset-panel-password|version]" ;;
esac
