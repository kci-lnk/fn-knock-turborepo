#!/bin/sh
set -e

[ -n "$IPKG_INSTROOT" ] && exit 0

if [ -x /etc/init.d/fn-knock ]; then
	if ! /etc/init.d/fn-knock stop >/dev/null 2>&1; then
		echo "fn-knock: failed to stop service; refusing to remove or upgrade package" >&2
		exit 1
	fi
	/etc/init.d/fn-knock disable >/dev/null 2>&1 || true
fi

if [ -x /usr/libexec/fn-knock-firewall ]; then
	if ! /usr/libexec/fn-knock-firewall remove >/dev/null 2>&1; then
		echo "fn-knock: warning: failed to remove the managed OpenWrt firewall rule" >&2
	fi
fi

exit 0
