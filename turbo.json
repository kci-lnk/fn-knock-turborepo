{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "server-admin-view#build": {
      "dependsOn": ["^build"],
      "env": ["FN_KNOCK_FRONTEND_TARGET", "VITE_FN_KNOCK_DEFAULT_AUTH_PORT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "../../scripts/create-precompressed-assets.mjs",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/icons/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "server-auth-view#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "../../scripts/create-precompressed-assets.mjs",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/icons/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "server-admin-rs#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../version.json",
        "../../packages/grpc-contracts/**",
        "../../packages/wol-protocol-rs/Cargo.toml",
        "../../packages/wol-protocol-rs/Cargo.lock",
        "../../packages/wol-protocol-rs/src/**"
      ],
      "outputs": []
    },
    "fn-knock-desktop#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../version.json",
        "../../packages/grpc-contracts/**",
        "bundle/windows/runtime/bundle.json"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "server-admin-view#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ]
    },
    "server-auth-view#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ]
    },
    "server-admin-rs#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../version.json",
        "../../packages/grpc-contracts/**",
        "../../packages/wol-protocol-rs/Cargo.toml",
        "../../packages/wol-protocol-rs/Cargo.lock",
        "../../packages/wol-protocol-rs/src/**"
      ]
    },
    "fn-knock-desktop#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../version.json",
        "../../packages/grpc-contracts/**",
        "bundle/windows/runtime/bundle.json"
      ]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "server-admin-view#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ]
    },
    "server-auth-view#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/admin-shared/src/**",
        "../../packages/frontend-core/src/**",
        "../../packages/i18n/src/**",
        "../../packages/ui-vue/src/**"
      ]
    },
    "server-admin-rs#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../version.json",
        "../../packages/grpc-contracts/**",
        "../../packages/wol-protocol-rs/Cargo.toml",
        "../../packages/wol-protocol-rs/Cargo.lock",
        "../../packages/wol-protocol-rs/src/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
