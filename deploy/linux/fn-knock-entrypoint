#!/usr/bin/env bash
set -euo pipefail

APP_HOME="${FN_KNOCK_APP_HOME:-/opt/fn-knock/current}"
DATA_DIR="${FN_KNOCK_DATA_DIR:-/var/lib/fn-knock}"
GATEWAY_CONFIG_DIR="${FN_KNOCK_GATEWAY_CONFIG_DIR:-/etc/fn-knock/gateway}"
BACKEND_PORT="${BACKEND_PORT:-7998}"
AUTH_PORT="${AUTH_PORT:-7997}"
ADMIN_VIEW_PORT="${ADMIN_VIEW_PORT:-7991}"
GO_BACKEND_PORT="${GO_BACKEND_PORT:-7996}"
GO_REPROXY_PORT="${GO_REPROXY_PORT:-7999}"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
AUTH_HOST="${AUTH_HOST:-127.0.0.1}"
ADMIN_VIEW_HOST="${ADMIN_VIEW_HOST:-0.0.0.0}"
GO_BACKEND_GRPC_ADDR="${GO_BACKEND_GRPC_ADDR:-127.0.0.1:${GO_BACKEND_PORT}}"
RUST_BACKEND_BIN="${APP_HOME}/bin/server-admin-rs"
GATEWAY_BIN="${APP_HOME}/bin/go-reauth-proxy"
ADMIN_STATIC_PATH="${APP_HOME}/ui/www"
AUTH_STATIC_PATH="${APP_HOME}/server-auth-view/dist"
ACME_BUNDLE_ZIP="${APP_HOME}/server/server-admin/resources/acmesh.zip"
RUNTIME_LOG_DIR="${DATA_DIR}/runtime/logs"
SUPERVISOR_LOG="${RUNTIME_LOG_DIR}/supervisor.jsonl"
SUPERVISOR_EVENTS_DIR="${DATA_DIR}/runtime/supervisor-events"

supervisor_log() {
  local level="$1" component="$2" event="$3" reason="$4" exit_code="${5:-null}"
  local signal="null"
  if [[ "${exit_code}" =~ ^[0-9]+$ ]] && [ "${exit_code}" -gt 128 ]; then
    signal="$((exit_code - 128))"
  fi
  mkdir -p "${RUNTIME_LOG_DIR}"
  chmod 700 "${DATA_DIR}/runtime" "${RUNTIME_LOG_DIR}" 2>/dev/null || true
  if [ -f "${SUPERVISOR_LOG}" ] && [ "$(wc -c < "${SUPERVISOR_LOG}")" -ge 516096 ]; then
    mv -f "${SUPERVISOR_LOG}" "${SUPERVISOR_LOG}.1"
  fi
  printf '{"time":"%s","level":"%s","component":"%s","event":"%s","reason_code":"%s","fields":{"exit_code":%s,"signal":%s}}\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${level}" "${component}" "${event}" "${reason}" "${exit_code}" "${signal}" >> "${SUPERVISOR_LOG}"
  chmod 600 "${SUPERVISOR_LOG}" 2>/dev/null || true
  mkdir -p "${SUPERVISOR_EVENTS_DIR}"
  chmod 700 "${SUPERVISOR_EVENTS_DIR}" 2>/dev/null || true
  local hint_tmp="${SUPERVISOR_EVENTS_DIR}/.hint-$$-${RANDOM:-0}.tmp"
  local hint_path="${SUPERVISOR_EVENTS_DIR}/$(date -u '+%s')-$$-${RANDOM:-0}-${event}.json"
  printf '{"time":"%s","level":"%s","component":"%s","event":"%s","reason_code":"%s","fields":{"exit_code":%s,"signal":%s}}\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${level}" "${component}" "${event}" "${reason}" "${exit_code}" "${signal}" > "${hint_tmp}"
  chmod 600 "${hint_tmp}" 2>/dev/null || true
  mv -f "${hint_tmp}" "${hint_path}"
  find "${SUPERVISOR_EVENTS_DIR}" -type f -name '*.json' -mtime +7 -exec rm -f {} \; 2>/dev/null || true
  find "${SUPERVISOR_EVENTS_DIR}" -type f -name '.hint-*.tmp' -mtime +1 -exec rm -f {} \; 2>/dev/null || true
  local hints=("${SUPERVISOR_EVENTS_DIR}"/*.json)
  while [ "${#hints[@]}" -gt 32 ]; do rm -f "${hints[0]}"; hints=("${SUPERVISOR_EVENTS_DIR}"/*.json); done
  local temp_hints=("${SUPERVISOR_EVENTS_DIR}"/.hint-*.tmp)
  while [ "${#temp_hints[@]}" -gt 32 ]; do rm -f "${temp_hints[0]}"; temp_hints=("${SUPERVISOR_EVENTS_DIR}"/.hint-*.tmp); done
}

generate_random_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  else
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

load_or_create_secret() {
  local name="$1"
  local path="$2"
  local value="${!name:-}"

  if [ -z "${value}" ] && [ -f "${path}" ]; then
    value="$(tr -d '\r\n' < "${path}")"
  fi
  if [ -z "${value}" ]; then
    value="$(generate_random_hex)"
    umask 077
    printf '%s' "${value}" > "${path}"
  fi
  chmod 600 "${path}" 2>/dev/null || true
  export "${name}=${value}"
}

wait_for_process_or_fail() {
  local pid="$1"
  local name="$2"
  sleep 1
  if ! kill -0 "${pid}" 2>/dev/null; then
    echo "[fn-knock] ${name} exited during startup" >&2
    set +e
    wait "${pid}"
    local status=$?
    set -e
    if [ "${name}" = "gateway" ]; then
      supervisor_log ERROR gateway_process exited startup_exit "${status}" || true
    else
      supervisor_log ERROR management exited startup_exit "${status}" || true
    fi
    exit 1
  fi
}

terminate_children() {
  for pid in "${BACKEND_PID:-}" "${GATEWAY_PID:-}"; do
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
    fi
  done
  wait "${BACKEND_PID:-}" 2>/dev/null || true
  wait "${GATEWAY_PID:-}" 2>/dev/null || true
}

cleanup() {
  local code=$?
  trap - EXIT INT TERM
  terminate_children
  exit "${code}"
}

stop_gracefully() {
  trap '' INT TERM
  echo "[fn-knock] stop requested; terminating services"
  supervisor_log INFO supervisor stop_requested signal null || true
  terminate_children
  exit 0
}

trap cleanup EXIT
trap stop_gracefully INT TERM

mkdir -p \
  "${DATA_DIR}" \
  "${DATA_DIR}/frp/instances" \
  "${DATA_DIR}/cloudflared" \
  "${DATA_DIR}/updates" \
  "${GATEWAY_CONFIG_DIR}"

load_or_create_secret ALTCHA_HMAC_KEY "${DATA_DIR}/altcha_hmac_key"
load_or_create_secret HMAC_SECRET "${DATA_DIR}/hmac_secret"
load_or_create_secret FN_KNOCK_INTERNAL_RPC_TOKEN "${DATA_DIR}/internal_rpc_token"
load_or_create_secret ADMIN_PROXY_SECRET "${DATA_DIR}/admin_proxy_secret"

for required in "${GATEWAY_BIN}" "${RUST_BACKEND_BIN}"; do
  [ -x "${required}" ] || { echo "[fn-knock] executable missing: ${required}" >&2; exit 1; }
done
for required in "${ADMIN_STATIC_PATH}" "${AUTH_STATIC_PATH}"; do
  [ -d "${required}" ] || { echo "[fn-knock] static directory missing: ${required}" >&2; exit 1; }
done
[ -f "${ACME_BUNDLE_ZIP}" ] || { echo "[fn-knock] ACME bundle missing: ${ACME_BUNDLE_ZIP}" >&2; exit 1; }

echo "[fn-knock] starting gateway: admin=${GO_BACKEND_PORT}, proxy=${GO_REPROXY_PORT}"
BACKEND_PORT="${BACKEND_PORT}" \
FN_KNOCK_DATA_DIR="${DATA_DIR}" \
FN_KNOCK_INTERNAL_RPC_TOKEN="${FN_KNOCK_INTERNAL_RPC_TOKEN}" \
FN_KNOCK_DISABLE_IPTABLES=1 \
"${GATEWAY_BIN}" \
  -c "${GATEWAY_CONFIG_DIR}" \
  -admin-port "${GO_BACKEND_PORT}" \
  -proxy-port "${GO_REPROXY_PORT}" &
GATEWAY_PID=$!
wait_for_process_or_fail "${GATEWAY_PID}" "gateway"
supervisor_log INFO gateway_process started supervisor_start null || true

echo "[fn-knock] starting administration service: ${ADMIN_VIEW_HOST}:${ADMIN_VIEW_PORT}"
(
  cd "${APP_HOME}"
  export \
    ADMIN_STATIC_PATH AUTH_STATIC_PATH ACME_BUNDLE_ZIP \
    DATA_DIR GATEWAY_CONFIG_DIR BACKEND_PORT AUTH_PORT ADMIN_VIEW_PORT \
    GO_BACKEND_PORT GO_REPROXY_PORT GO_BACKEND_GRPC_ADDR \
    BACKEND_HOST AUTH_HOST ADMIN_VIEW_HOST ALTCHA_HMAC_KEY HMAC_SECRET \
    FN_KNOCK_INTERNAL_RPC_TOKEN ADMIN_PROXY_SECRET
  FN_KNOCK_DATA_DIR="${DATA_DIR}" \
  FN_KNOCK_GATEWAY_CONFIG_DIR="${GATEWAY_CONFIG_DIR}" \
  FN_KNOCK_RUNTIME_TARGET="linux" \
  FN_KNOCK_BACKEND_IMPL="rust" \
  "${RUST_BACKEND_BIN}"
) &
BACKEND_PID=$!
wait_for_process_or_fail "${BACKEND_PID}" "administration service"
supervisor_log INFO management started supervisor_start null || true

echo "[fn-knock] services are ready"

# Bash 4.2 (still shipped by some supported systemd distributions) does not
# provide `wait -n`. Polling the two known child PIDs keeps the supervisor
# portable while Bash retains each completed job's exit status for `wait`.
while kill -0 "${GATEWAY_PID}" 2>/dev/null && kill -0 "${BACKEND_PID}" 2>/dev/null; do
  sleep 1
done

exited_name="gateway"
exited_pid="${GATEWAY_PID}"
if kill -0 "${GATEWAY_PID}" 2>/dev/null; then
  exited_name="administration service"
  exited_pid="${BACKEND_PID}"
fi

set +e
wait "${exited_pid}"
exited_status=$?
set -e
echo "[fn-knock] ${exited_name} exited unexpectedly with status ${exited_status}" >&2
if [ "${exited_name}" = "gateway" ]; then
  supervisor_log ERROR gateway_process exited unexpected_exit "${exited_status}" || true
else
  supervisor_log ERROR management exited unexpected_exit "${exited_status}" || true
fi

# A clean child exit is still unexpected. Exit non-zero so Restart=on-failure
# restarts the complete gateway/backend process group. The explicit TERM/INT
# path above exits zero, allowing `systemctl stop` to remain graceful.
exit 1
