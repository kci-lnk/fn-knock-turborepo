#!/bin/sh
set -u
umask 077

UBUS_BIN="${FN_KNOCK_FIREWALL_UBUS_BIN:-$(command -v ubus 2>/dev/null || true)}"
JSONFILTER_BIN="${FN_KNOCK_FIREWALL_JSONFILTER_BIN:-$(command -v jsonfilter 2>/dev/null || true)}"
FIREWALL_INIT="${FN_KNOCK_FIREWALL_INIT:-/etc/init.d/firewall}"
LOGGER_BIN="${FN_KNOCK_FIREWALL_LOGGER_BIN:-$(command -v logger 2>/dev/null || true)}"
STATUS_FILE="${FN_KNOCK_FIREWALL_STATUS_FILE:-/var/run/fn-knock-firewall.status}"
LOCK_BIN="${FN_KNOCK_FIREWALL_LOCK_BIN:-$(command -v lock 2>/dev/null || true)}"
LOCK_FILE="${FN_KNOCK_FIREWALL_LOCK_FILE:-/var/run/fn-knock-firewall.lock}"
SESSION_ID=""
LOCK_HELD=0

RULE_SECTION="fn_knock_gateway_ingress"
RULE_NAME="Allow-FnKnock-Gateway"
SOURCE_ZONE="wan"
RULE_FAMILY="any"

log_message() {
	local priority="$1"
	shift
	[ -n "$LOGGER_BIN" ] && "$LOGGER_BIN" -p "$priority" -t fn-knock-firewall "$*" 2>/dev/null || true
}

valid_port() {
	case "${1:-}" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

write_status() {
	local state="$1"
	local port="${2:-}"
	local temporary
	local port_json="null"

	valid_port "$port" && port_json="$port"
	temporary="$(mktemp "${STATUS_FILE}.XXXXXX" 2>/dev/null)" || return 0
	if ! printf '{"state":"%s","port":%s,"source_zone":"%s","family":"%s"}\n' \
		"$state" "$port_json" "$SOURCE_ZONE" "$RULE_FAMILY" > "$temporary"; then
		rm -f "$temporary"
		return 0
	fi
	mv -f "$temporary" "$STATUS_FILE" 2>/dev/null || rm -f "$temporary"
}

cleanup_runtime() {
	if [ -n "$SESSION_ID" ]; then
		"$UBUS_BIN" call session destroy \
			"{\"ubus_rpc_session\":\"${SESSION_ID}\"}" >/dev/null 2>&1 || true
		SESSION_ID=""
	fi
	if [ "$LOCK_HELD" = "1" ]; then
		"$LOCK_BIN" -u "$LOCK_FILE" >/dev/null 2>&1 || true
		LOCK_HELD=0
	fi
}

acquire_runtime() {
	local response

	if ! "$LOCK_BIN" "$LOCK_FILE" >/dev/null 2>&1; then
		log_message daemon.err "failed to acquire the FnKnock firewall synchronization lock"
		return 1
	fi
	LOCK_HELD=1
	# rpcd replaces the default /tmp/.uci delta path for authenticated sessions.
	# This prevents our commit from applying unrelated LuCI or CLI changes that
	# another administrator has staged but not committed yet.
	response="$("$UBUS_BIN" call session create '{"timeout":60}' 2>/dev/null)" || {
		log_message daemon.err "failed to create an isolated UCI session"
		return 1
	}
	SESSION_ID="$(printf '%s\n' "$response" | "$JSONFILTER_BIN" -e '@.ubus_rpc_session' 2>/dev/null || true)"
	case "$SESSION_ID" in
		''|*[!0-9a-fA-F]*)
			SESSION_ID=""
			log_message daemon.err "received an invalid isolated UCI session identifier"
			return 1
			;;
	esac
	if ! "$UBUS_BIN" call session grant \
		"{\"ubus_rpc_session\":\"${SESSION_ID}\",\"scope\":\"uci\",\"objects\":[[\"fn-knock\",\"read\"],[\"firewall\",\"read\"],[\"firewall\",\"write\"]]}" \
		>/dev/null 2>&1; then
		log_message daemon.err "failed to grant the isolated UCI session access"
		return 1
	fi
}

uci_get() {
	local key="$1"
	local config
	local remainder
	local section
	local option=""
	local request
	local response
	local expression='@.values[".type"]'

	[ -n "$SESSION_ID" ] || return 1
	config="${key%%.*}"
	remainder="${key#*.}"
	[ "$remainder" != "$key" ] || return 1
	section="${remainder%%.*}"
	if [ "$section" != "$remainder" ]; then
		option="${remainder#*.}"
		expression='@.value'
		request="{\"ubus_rpc_session\":\"${SESSION_ID}\",\"config\":\"${config}\",\"section\":\"${section}\",\"option\":\"${option}\"}"
	else
		request="{\"ubus_rpc_session\":\"${SESSION_ID}\",\"config\":\"${config}\",\"section\":\"${section}\"}"
	fi
	response="$("$UBUS_BIN" call uci get "$request" 2>/dev/null)" || return 1
	printf '%s\n' "$response" | "$JSONFILTER_BIN" -e "$expression" 2>/dev/null
}

uci_write_rule() {
	local operation="$1"
	local port="$2"
	local method="add"
	local identity="\"name\":\"${RULE_SECTION}\",\"type\":\"rule\""

	if [ "$operation" = "set" ]; then
		method="set"
		identity="\"section\":\"${RULE_SECTION}\""
	fi
	"$UBUS_BIN" call uci "$method" \
		"{\"ubus_rpc_session\":\"${SESSION_ID}\",\"config\":\"firewall\",${identity},\"values\":{\"name\":\"${RULE_NAME}\",\"src\":\"${SOURCE_ZONE}\",\"proto\":\"tcp\",\"dest_port\":\"${port}\",\"target\":\"ACCEPT\",\"family\":\"${RULE_FAMILY}\",\"enabled\":\"1\"}}" \
		>/dev/null 2>&1
}

uci_delete_rule() {
	"$UBUS_BIN" call uci delete \
		"{\"ubus_rpc_session\":\"${SESSION_ID}\",\"config\":\"firewall\",\"section\":\"${RULE_SECTION}\"}" \
		>/dev/null 2>&1
}

uci_commit_firewall() {
	"$UBUS_BIN" call uci commit \
		"{\"ubus_rpc_session\":\"${SESSION_ID}\",\"config\":\"firewall\"}" \
		>/dev/null 2>&1
}

config_enabled() {
	case "${1:-}" in
		1|on|true|yes|enabled) return 0 ;;
		*) return 1 ;;
	esac
}

runtime_available() {
	if [ -z "$UBUS_BIN" ] || [ ! -x "$UBUS_BIN" ]; then
		log_message daemon.err "OpenWrt ubus is unavailable; gateway ingress rule was not synchronized"
		return 1
	fi
	if [ -z "$JSONFILTER_BIN" ] || [ ! -x "$JSONFILTER_BIN" ]; then
		log_message daemon.err "OpenWrt jsonfilter is unavailable; gateway ingress rule was not synchronized"
		return 1
	fi
	if [ -z "$LOCK_BIN" ] || [ ! -x "$LOCK_BIN" ]; then
		log_message daemon.err "OpenWrt lock utility is unavailable; gateway ingress rule was not synchronized"
		return 1
	fi
	if [ ! -x "$FIREWALL_INIT" ]; then
		log_message daemon.err "OpenWrt firewall service is unavailable; gateway ingress rule was not synchronized"
		return 1
	fi
}

rule_exists() {
	uci_get "firewall.${RULE_SECTION}" >/dev/null 2>&1
}

rule_owned() {
	[ "$(uci_get "firewall.${RULE_SECTION}" 2>/dev/null || true)" = "rule" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.name" 2>/dev/null || true)" = "$RULE_NAME" ]
}

rule_matches() {
	local port="$1"
	rule_owned && \
		[ "$(uci_get "firewall.${RULE_SECTION}.src" 2>/dev/null || true)" = "$SOURCE_ZONE" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.proto" 2>/dev/null || true)" = "tcp" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.dest_port" 2>/dev/null || true)" = "$port" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.target" 2>/dev/null || true)" = "ACCEPT" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.family" 2>/dev/null || true)" = "$RULE_FAMILY" ] && \
		[ "$(uci_get "firewall.${RULE_SECTION}.enabled" 2>/dev/null || true)" = "1" ]
}

last_status_active_for_port() {
	local port="$1"
	[ -r "$STATUS_FILE" ] && \
		grep -Fq -- "{\"state\":\"active\",\"port\":${port},\"source_zone\":\"${SOURCE_ZONE}\",\"family\":\"${RULE_FAMILY}\"}" "$STATUS_FILE"
}

last_status_needs_removal_reload() {
	[ -r "$STATUS_FILE" ] && \
		grep -Eq -- '^\{"state":"(active|error)"' "$STATUS_FILE"
}

reload_firewall() {
	if "$FIREWALL_INIT" reload >/dev/null 2>&1; then
		return 0
	fi
	log_message daemon.err "OpenWrt firewall reload failed after synchronizing the FnKnock gateway ingress rule"
	return 1
}

remove_rule() {
	local port="${1:-}"

	if ! runtime_available; then
		write_status error "$port"
		return 1
	fi
	if ! rule_exists; then
		if last_status_needs_removal_reload && ! reload_firewall; then
			write_status error "$port"
			return 1
		fi
		write_status disabled "$port"
		return 0
	fi
	if ! rule_owned; then
		write_status conflict "$port"
		log_message daemon.err "refusing to remove unowned firewall.${RULE_SECTION} section"
		return 1
	fi
	if ! uci_delete_rule || ! uci_commit_firewall; then
		write_status error "$port"
		log_message daemon.err "failed to remove the FnKnock gateway ingress rule from UCI"
		return 1
	fi
	if ! reload_firewall; then
		write_status error "$port"
		return 1
	fi
	write_status disabled "$port"
	log_message daemon.info "removed the FnKnock gateway ingress rule"
}

sync_rule() {
	local service_enabled
	local auto_open
	local port
	local write_operation="add"

	if ! runtime_available; then
		write_status error ""
		return 1
	fi

	service_enabled="$(uci_get fn-knock.main.enabled 2>/dev/null || printf '1')"
	auto_open="$(uci_get fn-knock.main.auto_open_firewall 2>/dev/null || printf '0')"
	port="$(uci_get fn-knock.main.go_reproxy_port 2>/dev/null || printf '7999')"

	if ! config_enabled "$service_enabled" || ! config_enabled "$auto_open"; then
		remove_rule "$port"
		return $?
	fi
	if ! valid_port "$port"; then
		write_status error "$port"
		log_message daemon.err "invalid Go gateway proxy port; ingress rule was not synchronized"
		return 1
	fi
	if rule_exists && ! rule_owned; then
		write_status conflict "$port"
		log_message daemon.err "refusing to overwrite unowned firewall.${RULE_SECTION} section"
		return 1
	fi
	rule_exists && write_operation="set"
	if rule_matches "$port"; then
		if ! last_status_active_for_port "$port" && ! reload_firewall; then
			write_status error "$port"
			return 1
		fi
		write_status active "$port"
		return 0
	fi
	if ! uci_write_rule "$write_operation" "$port"; then
		write_status error "$port"
		log_message daemon.err "failed to stage the FnKnock gateway ingress rule in UCI"
		return 1
	fi
	if ! uci_commit_firewall; then
		write_status error "$port"
		log_message daemon.err "failed to commit the FnKnock gateway ingress rule to UCI"
		return 1
	fi
	if ! reload_firewall; then
		write_status error "$port"
		return 1
	fi
	write_status active "$port"
	log_message daemon.info "synchronized the FnKnock gateway ingress rule for TCP port $port"
}

show_status() {
	if [ -r "$STATUS_FILE" ]; then
		cat "$STATUS_FILE"
	else
		printf '{"state":"disabled","port":null,"source_zone":"%s","family":"%s"}\n' "$SOURCE_ZONE" "$RULE_FAMILY"
	fi
}

run_mutation() {
	local operation="$1"
	local result

	if ! runtime_available || ! acquire_runtime; then
		write_status error ""
		cleanup_runtime
		return 1
	fi
	trap cleanup_runtime EXIT
	trap 'cleanup_runtime; exit 1' HUP INT TERM

	case "$operation" in
		sync) sync_rule ;;
		remove) remove_rule "$(uci_get fn-knock.main.go_reproxy_port 2>/dev/null || printf '7999')" ;;
	esac
	result=$?
	cleanup_runtime
	trap - EXIT HUP INT TERM
	return "$result"
}

case "${1:-}" in
	sync)
		run_mutation sync
		;;
	remove)
		run_mutation remove
		;;
	status)
		show_status
		;;
	*)
		echo "Usage: $0 {sync|remove|status}" >&2
		exit 2
		;;
esac
