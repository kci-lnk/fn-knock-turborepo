config fn_knock 'main'
	option enabled '1'
	option app_home '/usr/lib/fn-knock'
	option data_dir '/etc/fn-knock/data'
	option gateway_config_dir '/etc/fn-knock/gateway'
	option backend_impl 'rust'
	option rust_backend_bin '/usr/lib/fn-knock/bin/server-admin-rs'
	option admin_view_host '0.0.0.0'
	option admin_view_port '7991'
	option backend_host '127.0.0.1'
	option backend_port '17998'
	option auth_host '127.0.0.1'
	option auth_port '7997'
	option go_backend_port '7996'
	option go_reproxy_port '7999'
	option root_share_dir ''
