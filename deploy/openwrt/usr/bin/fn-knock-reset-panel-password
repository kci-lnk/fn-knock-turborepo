#!/bin/sh
set -eu

CONFIG_NAME="fn-knock"

set +u
: "${IPKG_INSTROOT:=}"
. /lib/functions.sh

config_load "$CONFIG_NAME"
config_get app_home main app_home "/usr/lib/fn-knock"
config_get data_dir main data_dir "/var/lib/fn-knock"
config_get redis_host main redis_host "127.0.0.1"
config_get redis_port main redis_port "6379"
config_get redis_password main redis_password ""
set -u

entry="$app_home/server/server-admin-rs"

[ -x "$entry" ] || {
	echo "Rust backend is not executable: $entry" >&2
	exit 1
}

export FN_KNOCK_RUNTIME_TARGET=openwrt
export FN_KNOCK_DATA_DIR="$data_dir"
export REDIS_HOST="$redis_host"
export REDIS_PORT="$redis_port"
[ -n "$redis_password" ] && export REDIS_PASSWORD="$redis_password"

exec "$entry" reset-panel-password "$@"
