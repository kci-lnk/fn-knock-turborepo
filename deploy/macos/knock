#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="cn.fnknock.service"
APP_ROOT="/Library/Application Support/FnKnock"
LOG_DIR="/Library/Logs/FnKnock"
UNIT_FILE="/Library/LaunchDaemons/cn.fnknock.service.plist"
COMMAND_FILE="/usr/local/bin/knock"
LSOF_BIN="/usr/sbin/lsof"
TEST_MODE="${FN_KNOCK_TEST_MODE:-0}"
readonly TEST_MODE

if [ "${TEST_MODE}" = "1" ]; then
  APP_ROOT="${FN_KNOCK_APP_ROOT:-${APP_ROOT}}"
  LOG_DIR="${FN_KNOCK_LOG_DIR:-${LOG_DIR}}"
  UNIT_FILE="${FN_KNOCK_UNIT_FILE:-${UNIT_FILE}}"
  COMMAND_FILE="${FN_KNOCK_COMMAND_FILE:-${COMMAND_FILE}}"
  LSOF_BIN="${FN_KNOCK_LSOF_BIN:-${LSOF_BIN}}"
  for test_path in "${APP_ROOT}" "${LOG_DIR}" "${UNIT_FILE}" "${COMMAND_FILE}" "${LSOF_BIN}"; do
    case "${test_path}" in
      /tmp/*|/private/tmp/*|/var/folders/*) ;;
      *) printf '✗ 测试路径必须位于临时目录：%s\n' "${test_path}" >&2; exit 1 ;;
    esac
  done
fi

RELEASES_DIR="${APP_ROOT}/releases"
CURRENT_LINK="${APP_ROOT}/current"
PREVIOUS_LINK="${APP_ROOT}/previous"
CONFIG_DIR="${APP_ROOT}/config"
ENV_FILE="${CONFIG_DIR}/fn-knock.env"
DATA_DIR="${APP_ROOT}/data"
if [ "${TEST_MODE}" = "1" ]; then
  CONFIG_DIR="${FN_KNOCK_CONFIG_DIR:-${CONFIG_DIR}}"
  ENV_FILE="${FN_KNOCK_ENV_FILE:-${CONFIG_DIR}/fn-knock.env}"
  DATA_DIR="${FN_KNOCK_DATA_DIR:-${DATA_DIR}}"
  for test_path in "${CONFIG_DIR}" "${ENV_FILE}" "${DATA_DIR}"; do
    case "${test_path}" in
      /tmp/*|/private/tmp/*|/var/folders/*) ;;
      *) printf '✗ 测试路径必须位于临时目录：%s\n' "${test_path}" >&2; exit 1 ;;
    esac
  done
fi
if [ "${TEST_MODE}" != "1" ]; then
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  export PATH
  readonly PATH
fi
DEFAULT_BASE_URL="https://cdn.fnknock.cn"
MAX_ARCHIVE_SIZE=1073741824

if [ -t 1 ] && [ "${NO_COLOR:-}" != "1" ]; then
  C_RESET=$'\033[0m'
  C_TITLE=$'\033[1;38;5;45m'
  C_ACCENT=$'\033[1;38;5;213m'
  C_OK=$'\033[1;38;5;82m'
  C_WARN=$'\033[1;38;5;220m'
  C_ERR=$'\033[1;38;5;203m'
  C_DIM=$'\033[38;5;245m'
else
  C_RESET='' C_TITLE='' C_ACCENT='' C_OK='' C_WARN='' C_ERR='' C_DIM=''
fi

log() { printf '%s【fn-knock】%s %s\n' "${C_TITLE}" "${C_RESET}" "$*"; }
success() { printf '%s✓ %s%s\n' "${C_OK}" "$*" "${C_RESET}"; }
warn() { printf '%s⚠ %s%s\n' "${C_WARN}" "$*" "${C_RESET}" >&2; }
fail() { printf '%s✗ %s%s\n' "${C_ERR}" "$*" "${C_RESET}" >&2; exit 1; }

