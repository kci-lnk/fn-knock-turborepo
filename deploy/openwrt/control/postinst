#!/bin/sh
set -e

[ -n "$IPKG_INSTROOT" ] && exit 0

# Older releases generated an executable firewall cleanup script. OpenWrt
# never executes that script and removes the known legacy path on upgrade.
rm -f /var/lib/fn-knock/clean.sh 2>/dev/null || true

reload_luci() {
	rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null || true
	[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart >/dev/null 2>&1 || true
	[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart >/dev/null 2>&1 || true
}

if command -v uci >/dev/null 2>&1; then
	if [ "$(uci -q get fn-knock.main.admin_view_port)" = "7998" ]; then
		uci set fn-knock.main.admin_view_port="7991" >/dev/null 2>&1 || true
		uci commit fn-knock >/dev/null 2>&1 || true
	fi
fi

if [ -x /etc/init.d/fn-knock ]; then
	/etc/init.d/fn-knock enable >/dev/null 2>&1 || true
	/etc/init.d/fn-knock restart >/dev/null 2>&1 || true
fi

reload_luci

exit 0
